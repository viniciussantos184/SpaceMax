@startuml sequencia_partida
title SpaceMax - Sequencia de uma partida completa

skinparam sequenceMessageAlign center
autonumber

actor Jogador
participant "main.py" as Main
participant Jogo
participant PlanoDeFundo as Fundo
participant "sons" as Sons
participant "recorde" as Recorde
participant "interface" as UI
participant Nave
participant Tiro
participant Meteoro
participant Item
database "recorde.txt" as Arquivo

== Inicializacao ==
Main -> Jogo ** : Jogo()
activate Jogo
Jogo -> UI : Fontes()
Jogo -> Sons : criar_sons()
Sons --> Jogo : dict[str, Sound]
Jogo -> Recorde : carregar_recorde()
Recorde -> Arquivo : ler
Arquivo --> Recorde : valor
Recorde --> Jogo : recorde
Jogo -> Fundo ** : PlanoDeFundo()
Jogo -> Jogo : reiniciar()
Jogo -> Nave ** : Nave()
Jogo -> Jogo : lancar_onda()
Jogo -> Meteoro ** : Meteoro.na_borda(velocidade)
Jogo -> Jogo : estado = INICIO
Main -> Jogo : executar()

== Tela inicial ==
Jogo -> Meteoro : atualizar() (flutuam ao fundo)
Jogo -> UI : desenhar_tela_inicio(recorde, frame)
Jogador -> Jogo : ESPACO / clique
Jogo -> Jogo : reiniciar()\nestado = JOGANDO

== Jogando ==
loop a cada frame, enquanto vidas > 0
  Jogador -> Jogo : setas / WASD
  Jogo -> Nave : girar(direcao) / acelerar() / frear()

  opt ESPACO pressionado
    Jogo -> Nave : pode_atirar()
    Nave --> Jogo : True
    Jogo -> Nave : atirar()
    Nave -> Tiro ** : Tiro(x, y, angulo, vx, vy)
    Nave --> Jogo : tiro
    Jogo -> Sons : tocar("tiro")
  end

  opt hora de gerar asteroide (ou campo vazio)
    Jogo -> Meteoro ** : Meteoro.na_borda(velocidade)
  end

  opt hora de gerar item
    Jogo -> Item ** : Item()
  end

  Jogo -> Nave : atualizar() (inercia + atravessar bordas)
  Jogo -> Tiro : atualizar()
  Jogo -> Meteoro : atualizar()

  group checar_colisoes_tiro_meteoro()
    Jogo -> Tiro : colide_com(meteoro)
    Tiro --> Jogo : True
    Jogo -> Jogo : destruir_asteroide(meteoro)
    Jogo -> Meteoro : quebrar()
    alt grande ou medio
      Meteoro -> Meteoro : cria 2 fragmentos menores
      Meteoro --> Jogo : [fragmento, fragmento]
    else pequeno
      Meteoro --> Jogo : []
    end
    Jogo -> Jogo : pontuacao += meteoro.pontos
    Jogo -> Sons : tocar("explosao")
    Jogo -> Jogo : atualizar_nivel()
    opt nivel passou de 3 em 3
      Jogo -> Fundo : ir_para(proxima galaxia)
      Fundo --> Jogo : True
      Jogo -> Jogo : tingir_estrelas()\naviso "SETOR N"
    end
  end

  group checar_colisao_nave()
    opt nave coleta item
      Jogo -> Nave : colide_com(item)
      Nave --> Jogo : True
      Jogo -> Nave : ativar_escudo(6 s)
      Jogo -> Jogo : efeito_pegar_escudo()\n(2 ondas ambar, faiscas, tremor)
      Jogo -> Sons : tocar("item")
    end
    opt nave toca asteroide
      Jogo -> Nave : colide_com(meteoro)
      Nave --> Jogo : True
      alt com escudo
        Jogo -> Jogo : efeito_impacto_escudo(meteoro)\n(onda no impacto, faiscas, tremor)
        Jogo -> Nave : impacto_no_escudo()
        Jogo -> Jogo : destruir_asteroide(meteoro)
      else desprotegida
        Jogo -> Jogo : destruir_asteroide(meteoro)
        Jogo -> Jogo : perder_vida()
        Jogo -> Sons : tocar("colisao")
        alt vidas > 0
          Jogo -> Nave : reaparecer(invencivel 2 s)
        else vidas == 0
          Jogo -> Jogo : fim_de_jogo()
        end
      end
    end
  end

  Jogo -> Fundo : desenhar(tela)
  Jogo -> UI : desenhar_hud(pontos, recorde, nivel, vidas, setor)
end

== Game Over ==
Jogo -> Jogo : estado = GAMEOVER
opt pontuacao > recorde
  Jogo -> Recorde : salvar_recorde(pontuacao)
  Recorde -> Arquivo : gravar
end
Jogo -> UI : desenhar_tela_gameover(pontos, recorde, nivel, setor)

alt jogar novamente
  Jogador -> Jogo : ESPACO / clique
  Jogo -> Jogo : reiniciar()\nestado = JOGANDO
else sair
  Jogador -> Jogo : ESC / fechar janela
  Jogo -> Jogo : sair()
  deactivate Jogo
end

@enduml
