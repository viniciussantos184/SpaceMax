@startuml sequencia_frame
title SpaceMax - Sequencia de um frame (estado Jogando)

actor Jogador
participant "main.py" as Main
participant Jogo
participant PlanoDeFundo as Fundo
participant Nave
participant Meteoro
participant Tiro
participant "sons" as Sons
participant "interface" as UI

Main -> Jogo : Jogo()
Main -> Jogo : executar()

loop a cada frame (60 FPS)
  Jogador -> Jogo : teclado / mouse
  Jogo -> Jogo : processar_eventos()

  group atualizar()
    Jogo -> Fundo : atualizar()
    Jogo -> Meteoro : atualizar()
    Jogo -> Jogo : ler_controles()
    Jogo -> Nave : girar() / acelerar() / frear()
    opt ESPACO e nave.pode_atirar()
      Jogo -> Nave : atirar()
      Nave --> Jogo : Tiro
      Jogo -> Sons : tocar("tiro")
    end
    Jogo -> Nave : atualizar()
    Jogo -> Nave : emitir_rastro()
    Nave --> Jogo : particulas do motor
    Jogo -> Jogo : gerar_asteroides()
    Jogo -> Tiro : atualizar()

    Jogo -> Jogo : checar_colisoes_tiro_meteoro()
    Jogo -> Tiro : colide_com(meteoro)
    opt tiro acertou meteoro
      Jogo -> Jogo : destruir_asteroide(meteoro)
      Jogo -> Meteoro : quebrar()
      Meteoro --> Jogo : fragmentos menores
      Jogo -> Sons : tocar("explosao")
    end

    Jogo -> Jogo : checar_colisao_nave()
    Jogo -> Nave : colide_com(meteoro)
    opt meteoro atingiu nave desprotegida
      Jogo -> Jogo : perder_vida()
      Jogo -> Nave : reaparecer(invencivel)
    end
  end

  group desenhar()
    Jogo -> Fundo : desenhar(tela)
    Jogo -> Meteoro : desenhar(tela)
    Jogo -> Tiro : desenhar(tela)
    Jogo -> Nave : desenhar(tela)
    Jogo -> UI : desenhar_hud(...)
  end
end

@enduml
