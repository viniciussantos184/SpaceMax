@startuml estados
title SpaceMax - Estados do jogo

[*] --> Inicio

state "Inicio" as Inicio : titulo, controles e recorde\n(asteroides flutuam ao fundo)
state "Jogando" as Jogando {
  state "Normal" as Normal
  state "Invencivel" as Invencivel : nave pisca no centro\n(atravessa asteroides)
  state "Com escudo" as Escudo : destroi os asteroides\nque tocar

  [*] --> Invencivel : inicio da partida
  Invencivel --> Normal : tempo_invencivel chega a 0
  Normal --> Invencivel : atingida e vidas > 0\n[reaparecer()]
  Normal --> Escudo : coleta item (6 s)
  Escudo --> Normal : tempo_escudo chega a 0
  --
  state "Galaxia N" as GalaxiaN
  state "Galaxia N+1" as GalaxiaN1
  [*] --> GalaxiaN
  GalaxiaN --> GalaxiaN1 : nivel passa de 3 em 3\n[fundo.ir_para()]
}
state "Escolha do modo" as Modos : solo, coop, duelo,\ncorrida de pontos, sobrevivencia
state "Escolha dos jogadores" as Lobby : modos de 2 jogadores: cada um entra\ncom seu controle ou teclado (J1 / J2)
state "Entre rounds" as Round : duelo: mostra quem venceu\no round e recomeca a arena
state "Pausado" as Pausado : tudo congelado\nmostra controles e melhorias
state "Melhoria" as Melhoria : escolhe 1 de 3 cartas\n(ate 10 por partida)
state "Game Over" as GameOver : pontos, nivel e setor\n(salva recorde se superado)

Inicio --> Modos : ESPACO / clique
Modos --> Inicio : ESC / B
Modos --> Jogando : modo solo\n[comecar()]
Modos --> Lobby : modo de 2 jogadores
Lobby --> Modos : ESC / B
Lobby --> Jogando : ENTER / START com os dois prontos\n[comecar() com o modo escolhido]
Jogando --> Round : duelo: so um jogador sobrou
Round --> Jogando : proximo round
Round --> GameOver : alguem venceu 2 rounds
GameOver --> Modos : M / SELECT
Jogando --> Pausado : P / ENTER / ESC / START\n(ou foco perdido / controle desconectado)
Pausado --> Jogando : P / ENTER / START / B
Pausado --> Inicio : ESC / SELECT\n[voltar_ao_inicio()]
Jogando --> Melhoria : subiu de nivel\n(e ainda ha melhorias disponiveis)
Melhoria --> Jogando : carta escolhida
Jogando --> GameOver : regra do modo (ex.: ninguem vivo, tempo\nacabou, so um sobrou)
GameOver --> Jogando : ESPACO / clique\n[reiniciar() no mesmo modo]

Inicio --> [*] : ESC / fechar janela
GameOver --> [*] : ESC / fechar janela

@enduml
